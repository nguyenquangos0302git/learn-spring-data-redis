{
	"info": {
		"_postman_id": "8a329d48-6a57-4f99-923f-e1451f2fbc53",
		"name": "Learn Spring Data Redis - 5 Core Modules",
		"description": "Collection Postman kiểm thử đầy đủ 5 kiểu dữ liệu cốt lõi trong Redis (String, Hash, List, Set, Sorted Set) tương ứng với các Controller trong package `com.example.redis.modules`.\n\n### Biến môi trường:\n- `baseUrl`: `http://localhost:8080` (Mặc định của Spring Boot)\n\n### Giao diện quản lý Redis Commander GUI:\n- Truy cập `http://localhost:8081` để theo dõi keys và data thay đổi trực quan.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. String Module",
			"description": "Kiểu dữ liệu chuỗi cơ bản (Binary-safe, tối đa 512MB). Ánh xạ qua `redisTemplate.opsForValue()`",
